# 火山方舟直连鉴权
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# AI MediaKit 使用独立 API Key；默认接字幕擦除标准版
MEDIAKIT_API_KEY=your_mediakit_api_key
MEDIAKIT_BASE_URL=https://mediakit.cn-beijing.volces.com
MEDIAKIT_SUBMIT_PATH=/api/v1/tools/erase-video-subtitle
MEDIAKIT_TASK_PATH=/api/v1/tasks/{task_id}

# 模型选型
MODEL_CHAT=doubao-seed-2-1-pro-260628
# 视频反推模型固定在 server/start.mjs：doubao-seed-2-1-pro-260628
MODEL_IMAGE=doubao-seedream-5-0-260128
MODEL_VIDEO=doubao-seedance-2-0-mini-260615

# 专用 ASR（CVM 默认使用 whisper.cpp Docker + 本地模型）
WHISPER_MODEL_PATH=/opt/toushi-asr/ggml-large-v3-turbo-q5_0.bin
WHISPER_DOCKER_IMAGE=ghcr.io/ggml-org/whisper.cpp:main

# 后端端口
PORT=4322

# 站点登录鉴权（生产环境必填）
# 密码至少 8 位；AUTH_SECRET 至少 32 位随机字符。
APP_LOGIN_USERNAME=your_login_name
APP_LOGIN_PASSWORD=replace_with_a_strong_password
AUTH_SECRET=replace_with_at_least_32_random_characters

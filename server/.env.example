# 模型广场鉴权。到你自己的接入页面申请，然后拷贝一份为 server/.env
MUSE_CLIENT=your_client_id
MUSE_CLIENT_SECRET=your_client_secret

# 网关（默认已内置，两台等价，出问题就换 30.45.85.175）
MUSE_LLM_BASE=http://30.48.128.77:8080
MUSE_MEDIAKIT_BASE=http://30.48.128.77:8080

# 模型选型
MODEL_CHAT=gpt-5.5
# 视频反推模型固定在 server/start.mjs：doubao-seed-2-1-pro-260628（不允许覆盖/降级）
MODEL_IMAGE=doubao-seedream-5.0-lite
MODEL_VIDEO=doubao-seedance-2-0-260128

# 专用 ASR（CVM 默认使用 whisper.cpp Docker + 本地模型）
WHISPER_MODEL_PATH=/opt/toushi-asr/ggml-large-v3-turbo-q5_0.bin
WHISPER_DOCKER_IMAGE=ghcr.io/ggml-org/whisper.cpp:main

# 后端端口
PORT=4322
